{
  "name": "@whitemane/repo-map",
  "version": "0.15.0",
  "description": "An interactive architecture map for any repo, with plain-language process tracing through Claude Code, Codex, Gemini or any OpenAI-compatible API, including local models",
  "keywords": [
    "architecture",
    "diagram",
    "codebase-map",
    "onboarding",
    "developer-tools",
    "ai",
    "llm",
    "claude-code",
    "openai",
    "ollama"
  ],
  "license": "MIT",
  "author": "Johnathan LeBlanc",
  "homepage": "https://github.com/john77leblanc/repo-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john77leblanc/repo-map.git"
  },
  "bugs": {
    "url": "https://github.com/john77leblanc/repo-map/issues"
  },
  "type": "module",
  "bin": {
    "repo-map": "bin/repo-map.mjs"
  },
  "files": [
    "app/flowchart.mjs",
    "dist",
    "bin",
    "lib",
    "templates",
    "examples",
    "README.md",
    "SETUP.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md",
    "!examples/*/.repo-map/sitemap.json"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "prepare": "npm run build",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:node && npm run test:ui",
    "test:node": "node --test test/*.test.mjs",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "example": "npm run build && node bin/repo-map.mjs serve --dir examples/shop"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "mobx": "^7.1.0",
    "mobx-react-lite": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
