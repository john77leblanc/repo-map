    { "from": "cart-page", "to": "cart-store", "type": "event", "label": "reads items" },
    { "from": "checkout-page", "to": "cart-store", "type": "event", "label": "reads & clears" },
    { "from": "checkout-page", "to": "orders-client", "type": "event", "label": "placeOrder" },
    { "from": "orders-client", "to": "payments-client", "type": "event", "label": "chargeCard" },
    { "from": "payments-client", "to": "payments-api", "type": "http", "label": "POST /charges" },
    { "from": "orders-client", "to": "orders-api", "type": "http", "label": "POST /orders" }
  ]
